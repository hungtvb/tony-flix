# TonyFlix — env mẫu. Copy thành .env.local (dev) hoặc đặt trên Railway.

# --- Database (PostgreSQL) ---
# Chuỗi kết nối Postgres. Có thì tài khoản lưu DB (bảng users, tự tạo + seed
# admin lần đầu chạy); thiếu thì fallback sang AUTH_USERS bên dưới.
DATABASE_URL=postgres://user:pass@host:5432/tonyflix

# --- Auth ---
# Fallback khi chưa có DATABASE_URL: "user:pass,user2:pass2"
AUTH_USERS=admin:tonyflix
# Khóa ký cookie phiên HMAC-SHA256 — ĐỔI ngay khi lên production:
AUTH_SECRET=doi-chuoi-ngau-nhien-o-day

# --- E2E (npm run e2e / scripts/e2e-with-auth.sh) ---
E2E_DB_USER=dbonly
E2E_DB_PASS=dbpass123
