# TonyFlix — env mẫu. Copy thành .env.local (dev) hoặc đặt trên Railway.
# Tài khoản: "user:pass,user2:pass2" (nhiều người dùng, phân tách bởi dấu phẩy)
AUTH_USERS=admin:tonyflix
# Khóa ký cookie phiên — ĐỔI ngay khi lên production:
AUTH_SECRET=doi-chuoi-ngau-nhien-o-day

# --- Chỉ cho e2e (npm run e2e) ---
AUTH_USERS_E2E=admin:tonyflix
